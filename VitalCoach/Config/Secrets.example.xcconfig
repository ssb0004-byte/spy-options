// Copy this file to Config/Secrets.xcconfig (git-ignored) and fill in your values.
// NEVER put the Supabase service_role key or an OpenAI key here: anything in the app
// bundle can be extracted by anyone who downloads the app.

// Your Apple Developer Team ID (Xcode → Settings → Accounts, or developer.apple.com → Membership).
VC_DEVELOPMENT_TEAM = ABCDE12345

// A unique bundle identifier you own, e.g. com.yourname.vitalcoach
VC_BUNDLE_ID = com.yourname.vitalcoach

// Supabase → Project Settings → API. Host only, WITHOUT https:// (xcconfig treats // as a comment).
SUPABASE_HOST = YOUR_PROJECT_REF.supabase.co

// The "anon" / "publishable" key. It is designed to be public; Row Level Security protects data.
SUPABASE_ANON_KEY = YOUR_ANON_KEY
